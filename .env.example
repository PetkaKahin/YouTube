# Copy to .env or run ./docker/run init. Never commit .env.
# Only non-secret settings belong here. init creates Compose Secret files in docker/secrets/.

# Application: passed to Python by Docker Compose
APP_NAME="YouTube API"
# Administrator retries: jobs per portion and queue capacity used by retry admission.
# Tune for this server; does not change worker concurrency or ordinary submissions.
JOB_RETRY_BATCH_SIZE=20

# Docker Compose and HTTP entry point
COMPOSE_PROJECT_NAME=youtube
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Persistent database
POSTGRES_DB=youtube
POSTGRES_USER=youtube
# Host IDE port, dev only; containers always use postgres:5432.
POSTGRES_PORT=5432

# Object storage development-only host ports
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# API client generator: internal Docker address, never a browser URL
OPENAPI_URL=http://python:8000/openapi.json

# Shared media-worker/media-tools policy; never applied to API/upload maintenance.
MEDIA_CPUS=2
MEDIA_MEMORY=8g
MEDIA_WORKSPACE_BYTES=34359738368
MEDIA_RESERVE_BYTES=2147483648
MEDIA_IDLE_SECONDS=1800
MEDIA_ATTEMPT_SECONDS=604800
