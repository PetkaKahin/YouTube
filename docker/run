#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$project_dir"

usage() {
    cat <<'HELP'
Usage:
  docker/run init                  Create local secrets and missing lock files in Docker
  docker/run lock                  Refresh both lock files in Docker
  docker/run setup                 Build dev, migrate and start the application
  docker/run refresh               Reset dev database and temporary state, migrate and seed
  docker/run dev <compose args>    Use development configuration
  docker/run prod <compose args>   Use production configuration
  docker/run media <compose args>  Isolated CPU media qualification (no queue or secrets)
  docker/run check                 Check running development environment and code
  docker/run audit [dev|prod]      Inspect metadata, processes, logs and HTTP for secret leaks
  docker/run context-check         Check Docker ignore rules with BuildKit context exports

Examples:
  docker/run dev up --build -d --wait
  docker/run dev logs -f
  docker/run dev exec python pytest
  docker/run dev exec node npm run api:generate
  docker/run prod up --build -d --wait
  docker/run prod down
HELP
}

require_docker() {
    command -v docker >/dev/null || { printf 'Docker is required.\n' >&2; exit 1; }
    docker compose version >/dev/null
    docker info >/dev/null
}

bootstrap() {
    docker compose --project-directory "$project_dir" \
        --env-file docker/versions.env -f docker-compose.bootstrap.yml "$@"
}

container_user="$(id -u):$(id -g)"

secrets_ready() {
    local secret
    for secret in postgres_password valkey_password rustfs_access_key rustfs_secret_key csrf_secret; do
        [[ -s docker/secrets/$secret ]] || return 1
    done
}

prepare() {
    require_docker
    bootstrap build python node
    bootstrap run --rm --no-deps --user "$container_user" \
        python python /project/docker/python/prepare_env.py
    if [[ ${1:-} == refresh || ! -f backend/uv.lock ]]; then
        bootstrap run --rm --no-deps --user "$container_user" python uv lock
    fi
    if [[ ${1:-} == refresh || ! -f frontend/package-lock.json ]]; then
        bootstrap run --rm --no-deps --user "$container_user" \
            node npm install --package-lock-only --ignore-scripts
    fi
}

compose() {
    local mode=$1
    shift
    local files=(-f docker-compose.yml)
    local config_env=.env
    if [[ $mode == media ]]; then
        files=(-f docker-compose.media.yml)
        [[ -f $config_env ]] || config_env=.env.example
    fi
    if [[ $mode == dev ]]; then
        files+=(-f docker-compose.dev.yml)
    fi
    docker compose --project-directory "$project_dir" \
        --env-file docker/versions.env --env-file "$config_env" "${files[@]}" "$@"
}

start_dev() {
    compose dev up -d --wait postgres valkey rustfs
    compose dev run --rm --no-deps -T rustfs-init
    compose dev run --rm --no-deps -T python alembic upgrade head
    compose dev up -d --wait
}

setup() {
    prepare
    compose dev build
    compose dev stop python upload-maintenance media-worker nginx node
    start_dev
}

refresh() {
    require_docker
    if [[ ! -f .env ]] || ! secrets_ready; then
        prepare
    fi
    local identifiers=() container configurations
    local listing
    listing=$(compose dev ps --all --quiet)
    if [[ -n $listing ]]; then
        mapfile -t identifiers <<< "$listing"
    fi
    for container in "${identifiers[@]}"; do
        configurations=$(docker inspect --format \
            '{{ index .Config.Labels "com.docker.compose.project.config_files" }}' "$container")
        if [[ ,$configurations, != *",$project_dir/docker-compose.dev.yml,"* ]]; then
            printf 'Refresh отменён: в этом Compose-проекте есть контейнеры вне dev.\n' >&2
            return 1
        fi
    done
    local configuration volumes=() volume owner
    # Avoid capturing Compose's automatic-build messages alongside the four values.
    bootstrap build python >&2
    configuration=$(compose dev config --format json | bootstrap run --rm --no-deps -T python \
        python -c 'import json,sys
config=json.load(sys.stdin)
print(config["name"])
for key in ("postgres_data", "job_error_spool", "media_scratch"):
    volume=config["volumes"][key]
    if volume.get("external"):
        raise SystemExit("Refresh refuses external volumes")
    print(volume["name"])')
    mapfile -t volumes <<< "$configuration"
    [[ ${#volumes[@]} == 4 ]] || { printf 'Не удалось определить тома dev.\n' >&2; return 1; }
    for volume in "${volumes[@]:1}"; do
        if docker volume inspect "$volume" >/dev/null 2>&1; then
            owner=$(docker volume inspect --format \
                '{{ index .Labels "com.docker.compose.project" }}' "$volume")
            [[ $owner == "${volumes[0]}" ]] || {
                printf 'Refresh отменён: том %s принадлежит другому проекту.\n' "$volume" >&2
                return 1
            }
        fi
    done
    # Finish the build before discarding data; workers only start after migration.
    compose dev build
    compose dev down --remove-orphans
    for volume in "${volumes[@]:1}"; do
        if docker volume inspect "$volume" >/dev/null 2>&1; then
            docker volume rm "$volume"
        fi
    done
    start_dev
    compose dev exec -T -e PYTHONPATH=/app/src media-worker python -m app.seed
    printf 'БД dev пересоздана и заполнена тестовыми данными.\n'
}

check() {
    require_docker
    compose dev config --quiet
    compose dev exec -T nginx nginx -t
    compose dev exec -T python python - < docker/python/check_media.py
    compose dev exec -T python python - < docker/python/check_hls.py
    compose media run --build --rm -T media-tools python - < docker/python/check_media_resources.py
    compose dev exec -T python ruff check .
    compose dev exec -T python ruff format --check .
    compose dev exec -T python basedpyright
    compose dev exec -T python tach check
    compose dev exec -T python tach check-external --exclude 'tests,src/*/tests'
    compose dev exec -T python pytest
    compose dev exec -T python uv audit --locked
    compose dev exec -T node npm run lint
    compose dev exec -T node npm run format:check
    compose dev exec -T node npm test
    compose dev exec -T node npm audit
    compose dev exec -T node npm run build
    compose dev exec -T python python - < docker/python/smoke.py
    printf 'Checks passed.\n'
}

audit() {
    require_docker
    local mode=${1:-dev}
    [[ $mode == dev || $mode == prod ]] || { usage; exit 1; }
    local identifiers=()
    mapfile -t identifiers < <(compose "$mode" ps --all --quiet)
    [[ ${#identifiers[@]} -gt 0 ]] || { printf 'No project containers found.\n' >&2; exit 1; }
    compose "$mode" config --format json | bootstrap run --rm --no-deps -T --user 0:0 \
        --volume "$project_dir:/project:ro" \
        --volume /var/run/docker.sock:/var/run/docker.sock:ro \
        python python /project/docker/python/audit.py "${identifiers[@]}"
}

context_check() (
    require_docker
    probe_dir=$(mktemp -d)
    probe_builder="youtube-context-$$"
    trap 'docker buildx rm --force "$probe_builder" >/dev/null 2>&1 || :; rm -rf -- "$probe_dir"' EXIT
    docker buildx create --name "$probe_builder" --driver docker-container >/dev/null
    for component in python node nginx root; do
        recipe="$probe_dir/$component.Dockerfile"
        cat > "$recipe" <<'DOCKERFILE'
FROM scratch AS base
FROM base AS dev
COPY . /
FROM base AS prod
COPY . /
DOCKERFILE
        if [[ $component == root ]]; then
            cp .dockerignore "$recipe.dockerignore"
        else
            cp "docker/$component/Dockerfile.dockerignore" "$recipe.dockerignore"
        fi
        docker buildx build --builder "$probe_builder" --file "$recipe" --target dev --output type=tar,dest=- . \
            | bootstrap run --rm --no-deps -T --user 0:0 \
                --volume "$project_dir:/project:ro" \
                python python /project/docker/python/check_context.py "$component"
    done
)

case ${1:-help} in
    init) prepare ;;
    lock) prepare refresh ;;
    setup) setup ;;
    refresh) refresh ;;
    check) check ;;
    audit) shift; audit "$@" ;;
    context-check) context_check ;;
    media)
        shift
        [[ $# -gt 0 ]] || { usage; exit 1; }
        require_docker
        compose media "$@"
        ;;
    dev|prod)
        mode=$1
        shift
        [[ $# -gt 0 ]] || { usage; exit 1; }
        case $1 in
            up|build|run)
                if [[ ! -f .env || ! -f backend/uv.lock || ! -f frontend/package-lock.json ]] \
                    || ! secrets_ready \
                    || ! compose "$mode" config --quiet >/dev/null 2>&1; then
                    prepare
                fi
                ;;
        esac
        if [[ ! -f .env ]]; then
            printf 'Run docker/run init first.\n' >&2
            exit 1
        fi
        compose "$mode" "$@"
        ;;
    help|--help|-h) usage ;;
    *) usage; exit 1 ;;
esac
